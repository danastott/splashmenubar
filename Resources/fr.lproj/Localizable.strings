// Chaînes françaises pour SplashMenuBar.
// Key = the key Foundation derives from the Swift source literal;
// value = the English text. Translate a language by copying this file
// into <lang>.lproj/Localizable.strings and replacing the values.

"DECODE SPEED · TOK/S" = "VITESSE DE DÉCODAGE · TOK/S";
"Decode speed (tok/s): the last %lld samples taken while a request is generating, every %@ (span and UI refresh in Settings). Samples are evenly spaced by count, not by wall-clock time — idle gaps don't stretch them. The dotted line is the average of the samples shown. Right-click to pick the line's color." = "Vitesse de décodage (tok/s) : les %lld derniers échantillons relevés pendant la génération d'une requête, tous les %@ (durée et actualisation de l'interface dans Réglages). Les échantillons sont espacés régulièrement par nombre, et non par temps réel — les pauses inactives ne les étirent pas. La ligne pointillée est la moyenne des échantillons affichés. Clic droit pour choisir la couleur de la ligne.";
"LAST REQUEST" = "DERNIÈRE REQUÊTE";
"Figures for the most recently finished request, from splash's Done log line." = "Chiffres de la requête la plus récemment terminée, issus de la ligne Done des journaux de splash.";
"LOAD" = "CHARGE";
"Server-wide totals and averages since splash started." = "Totaux et moyennes du serveur depuis le démarrage de splash.";
"SERVER" = "SERVEUR";
"What splash is serving and where." = "Ce que splash sert et où.";
"external" = "externe";
"This server wasn't started by Splash Menu Bar (e.g. run from a terminal). Stop still shuts it down; quitting the app leaves it running." = "Ce serveur n'a pas été démarré par Splash Menu Bar (par ex. depuis un terminal). « Arrêter » le met quand même hors service ; quitter l'app le laisse fonctionner.";
"Unpin" = "Détacher";
"Pin" = "Épingler";
"Pinned: this panel stays open until you unpin it, and you can drag it anywhere by its top edge. Click to unpin and snap it back under the menu bar." = "Épinglé : ce panneau reste ouvert jusqu'à son détachement ; vous pouvez le faire glisser n'importe où par son bord supérieur. Cliquez pour le détacher et le replacer sous la barre des menus.";
"Pin this panel open, so clicking elsewhere, pressing Esc or using its buttons doesn't close it. Pinned, you can drag it anywhere on screen by its top edge." = "Épingler ce panneau pour qu'un clic ailleurs, la touche Échap ou l'usage de ses boutons ne le ferment pas. Épinglé, vous pouvez le faire glisser n'importe où sur l'écran par son bord supérieur.";
"Settings (⌘,): edit the splash serve options. Saving restarts the server." = "Réglages (⌘,) : modifier les options du serveur splash. L'enregistrement redémarre le serveur.";
"Starting splash…" = "Démarrage de splash…";
"What splash is doing before it can serve: the current stage, download progress (size · speed · time left), time since launch, and its latest output line." = "Ce que splash fait avant de pouvoir servir : l'étape en cours, la progression du téléchargement (taille · vitesse · temps restant), le temps écoulé depuis le lancement et sa dernière ligne de sortie.";
"splash exited" = "splash s'est terminé";
"splash exited: %@. The lines below are its last output; select the text to copy it. Press Start to run it again." = "splash s'est terminé : %@. Les lignes ci-dessous sont sa dernière sortie ; sélectionnez le texte pour le copier. Appuyez sur Démarrer pour le relancer.";
"A splash server started outside the app is serving port %lld, so the app uses that one. Restart runs splash from the app instead." = "Un serveur splash démarré en dehors de l'app sert le port %lld ; l'app l'utilise donc. « Redémarrer » lance splash depuis l'app à la place.";
"The splash this app started exited, but an externally started splash is serving port %lld — the app is using that server. Restart shuts it down and runs splash from the app with the current settings." = "Le splash démarré par cette app s'est terminé, mais un splash démarré en externe sert le port %lld — l'app utilise ce serveur. « Redémarrer » l'arrête et lance splash depuis l'app avec les réglages actuels.";
"port in use" = "port occupé";
"Something else (not splash) is serving port %lld, so the splash the app started exited. Stop that service — or change the port in Settings — then press Start." = "Un autre service (pas splash) sert le port %lld ; le splash démarré par l'app s'est donc terminé. Arrêtez ce service — ou changez le port dans Réglages — puis appuyez sur Démarrer.";
"A service other than splash is listening on port %lld — the splash this app started exited because the port was taken. Stop the other service or change the port in Settings." = "Un service différent de splash écoute sur le port %lld — le splash démarré par cette app s'est terminé parce que le port était occupé. Arrêtez l'autre service ou changez le port dans Réglages.";
"splash %@ available" = "splash %@ disponible";
"Update Splash" = "Mettre à jour splash";
"Confirm and update splash to %@ through Homebrew; afterwards the server can be restarted onto it." = "Confirmer et mettre splash à jour vers %@ via Homebrew ; le serveur pourra ensuite être redémarré dessus.";
"the newest version" = "la dernière version";
"Installed: %@. The update runs `brew upgrade %@`." = "Installé : %@. La mise à jour exécute `brew upgrade %@`.";
"A newer splash release is available. Update Splash runs brew upgrade for the splash formula; the server restarts only if you confirm it afterwards." = "Une nouvelle version de splash est disponible. « Mettre à jour splash » exécute brew upgrade pour la formule splash ; le serveur ne redémarre que si vous confirmez ensuite.";
"Splash Menu Bar %@ available" = "Splash Menu Bar %@ disponible";
"Update App" = "Mettre à jour l'app";
"Confirm and update Splash Menu Bar to %@ through Homebrew; the app relaunches afterwards." = "Confirmer et mettre Splash Menu Bar à jour vers %@ via Homebrew ; l'app se relance ensuite.";
"Installed: %@. The update runs `brew upgrade --cask splashmenubar`." = "Installé : %@. La mise à jour exécute `brew upgrade --cask splashmenubar`.";
"A newer Splash Menu Bar release is available. Update App runs brew upgrade for the splashmenubar cask; the app relaunches onto it." = "Une nouvelle version de Splash Menu Bar est disponible. « Mettre à jour l'app » exécute brew upgrade pour le cask splashmenubar ; l'app se relance dessus.";
"Get started" = "Commencer";
"Dismiss tip" = "Masquer l'astuce";
"Hide this tip." = "Masquer cette astuce.";
"No splash server is running. Open Settings to choose a splash model, then press ▶ Start. To have the server start whenever the app launches, turn on Start 'splash' server on launch." = "Aucun serveur splash ne tourne. Ouvrez Réglages pour choisir un modèle splash, puis appuyez sur ▶ Démarrer. Pour que le serveur démarre à chaque lancement de l'app, activez « Démarrer le serveur splash au lancement ».";
"Open Settings…" = "Ouvrir les réglages…";
"Choose a model and other splash options." = "Choisir un modèle et d'autres options splash.";
"Engine error" = "Erreur du moteur";
"Metal is reporting a failure; requests may fail or hang until splash is restarted.%@" = "Metal signale une défaillance ; les requêtes peuvent échouer ou se bloquer jusqu'au redémarrage de splash.%@";
"Engine recovering" = "Moteur en récupération";
"The inference engine crashed and is restarting; requests can't be served until it's back.%@" = "Le moteur d'inférence a planté et redémarre ; les requêtes ne peuvent pas être servies jusqu'à son retour.%@";
"Engine unstable" = "Moteur instable";
"The inference engine has crashed and restarted since startup;%@ if it keeps happening, restart splash." = "Le moteur d'inférence a planté et redémarré depuis le démarrage ;%@ s'il recommence, redémarrez splash.";
" Restarted %lld× since startup." = " %lld× redémarrages depuis le démarrage.";
"Yellow: splash is starting (downloading or loading the model)." = "Jaune : splash démarre (téléchargement ou chargement du modèle).";
"Green: splash is running and ready for requests." = "Vert : splash est en cours et prêt à traiter les requêtes.";
"Green: splash is running." = "Vert : splash est en cours.";
"Red: splash exited unexpectedly (%@). Press Start to run it again." = "Rouge : splash s'est terminé de façon inattendue (%@). Appuyez sur Démarrer pour le relancer.";
"Gray: splash is stopped. Press Start to run it." = "Gris : splash est arrêté. Appuyez sur Démarrer pour le lancer.";
"Thermal state of this Mac: macOS's system-wide thermal-pressure state, reported to the app through splash.\n%@\nLevels: nominal → fair → serious → critical.\nThe OS sets it from the whole system and changes it slowly, so it can temporarily disagree with the chip temperature shown next to it." = "État thermique de ce Mac : état de pression thermique système de macOS, transmis à l'app via splash.\n%@\nNiveaux : nominal → fair → serious → critical.\nLe système l'établit pour l'ensemble de la machine et le modifie lentement ; il peut donc temporairement diverger de la température de la puce affichée à côté.";
"Chip temperature: %@ — the hottest CPU/GPU die sensor, read directly by the app (not from splash). The unit follows the Temperature setting; System uses the computer's region." = "Température de la puce : %@ — le capteur de die CPU/GPU le plus chaud, lu directement par l'app (et non par splash). L'unité suit le réglage Température ; Système utilise la région de l'ordinateur.";
"Nominal: normal temperature, no thermal limits." = "Nominal : température normale, aucune limite thermique.";
"Fair: slightly warm. Fans may spin up and macOS may trim background work; speeds are usually unaffected." = "Fair : légèrement chaud. Les ventilateurs peuvent accélérer et macOS peut réduire les tâches en arrière-plan ; les vitesses sont généralement inchangées.";
"Serious: hot. macOS is throttling the CPU and GPU, so tok/s and prefill speed will drop." = "Serious : chaud. macOS réduit les performances de la CPU et du GPU ; la vitesse en tok/s et le préfill vont baisser.";
"Critical: very hot. Heavy throttling until the Mac cools down." = "Critical : très chaud. Fort ralentissement jusqu'au refroidissement du Mac.";
"Current state: %@." = "État actuel : %@.";
"tok/s" = "tok/s";
"Decode speed: tokens generated per second right now, or the average since splash started when idle. The ring auto-scales to the speed graph's window: full ring = a round number at or above the highest tok/s it shows (the graph's top gridline), so 180 tok/s reads instead of pinning the ring. Below the value: the average of the samples the speed graph shows (its dotted line). Right-click to pick the ring's color." = "Vitesse de décodage : tokens générés par seconde en ce moment, ou la moyenne depuis le démarrage de splash en cas d'inactivité. L'anneau s'échelle automatiquement sur la fenêtre du graphique de vitesse : anneau plein = un nombre rond supérieur ou égal au plus haut tok/s affiché (ligne de grille supérieure du graphique), de sorte que 180 tok/s se lisent au lieu de rester bloqué. Sous la valeur : moyenne des échantillons affichés par le graphique (sa ligne pointillée). Clic droit pour choisir la couleur de l'anneau.";
"prefill" = "prefill";
"While a prompt is prefilling: how much of it is done (the ring fills as it goes) and the estimated time left. Otherwise: prefill speed in tokens per second, from the last prefill or the average since splash started; a full ring = 500 tok/s. Right-click to pick the ring's color." = "Pendant le préfill d'un prompt : la part accomplie (l'anneau se remplit au fil de l'avancement) et le temps restant estimé. Sinon : vitesse de préfill en tokens par seconde, issue du dernier préfill ou de la moyenne depuis le démarrage de splash ; anneau plein = 500 tok/s. Clic droit pour choisir la couleur de l'anneau.";
"cached" = "en cache";
"KV cache hit rate since the server started: the share of prompt tokens served from the cache instead of being prefilled again (the per-request figure is LAST REQUEST → Input / cached). Right-click to pick the ring's color." = "Taux de hit du cache KV depuis le démarrage du serveur : part des tokens du prompt servis depuis le cache au lieu d'être re-préfillés (le chiffre par requête est DERNIÈRE REQUÊTE → Entrée / en cache). Clic droit pour choisir la couleur de l'anneau.";
"GPU" = "GPU";
"GPU use across the whole Mac: share of time the GPU was busy, as Activity Monitor reports it. Right-click to pick the bar's color." = "Utilisation du GPU sur tout le Mac : part du temps pendant lequel le GPU a été actif, telle que Activity Monitor la rapporte. Clic droit pour choisir la couleur de la barre.";
"CPU" = "CPU";
"CPU use across the whole Mac: share of all cores' time spent busy since the last refresh. Right-click to pick the bar's color." = "Utilisation de la CPU sur tout le Mac : part du temps de tous les cœurs passée à travailler depuis la dernière actualisation.";
"RAM" = "RAM";
"Memory used across the whole Mac (app memory + wired + compressed, as Activity Monitor counts it): %@ of %@" = "Mémoire utilisée sur tout le Mac (mémoire des apps + mémoire câblée + mémoire compressée, telle que Activity Monitor la compte) : %@ sur %@";
"Memory used across the whole Mac (app memory + wired + compressed, as Activity Monitor counts it)" = "Mémoire utilisée sur tout le Mac (mémoire des apps + mémoire câblée + mémoire compressée, telle que Activity Monitor la compte)";
"%@. The bar's color follows the server's memory-pressure report — %@" = "%@. La couleur de la barre suit le rapport de pression mémoire du serveur — %@";
"green = normal, yellow = warning, red = critical" = "vert = normal, jaune = avertissement, rouge = critique";
"%@; the server hasn't reported one yet." = "%@ ; le serveur n'en a pas encore signalé.";
"normal — the Mac has memory to spare" = "normal — le Mac dispose de mémoire de réserve";
"warning — the system is under memory load; splash's requests may be slower or suspended" = "avertissement — le système est sous pression mémoire ; les requêtes de splash peuvent être plus lentes ou suspendues";
"critical — macOS is reclaiming memory aggressively; splash may refuse or drop requests until it eases off" = "critique — macOS réclame la mémoire de manière agressive ; splash peut refuser ou abandonner des requêtes tant que ça ne se calme pas";
"%@; right now: %@" = "%@ ; actuellement : %@";
"Output (last)" = "Sortie (dernière)";
"Tokens the last request generated." = "Tokens générés par la dernière requête.";
"Input / cached" = "Entrée / en cache";
"Prompt tokens of the last request / how many of them were reused from the prompt cache instead of being prefilled again. Of the uncached rest, a further share could still read KV that other requests had already computed — the niche \"deduplicated\" figure, no longer shown as its own row." = "Tokens du prompt de la dernière requête / combien ont été réutilisés depuis le cache de prompt au lieu d'être re-préfillés. Du reste non mis en cache, une part supplémentaire pouvait encore lire du KV que d'autres requêtes avaient déjà calculé — le chiffre niche « dédupliqué », plus affiché en tant que ligne à part.";
"TTFT (last)" = "TTFT (dernier)";
"Time to first token of the last request: from arrival until its first output token (mostly prefill)." = "Temps jusqu'au premier token de la dernière requête : de son arrivée jusqu'à son premier token de sortie (surtout préfill).";
"Tok/cycle" = "Tok/cycle";
"Tokens produced per decode cycle with the draft model: 1 + accepted draft tokens per cycle. Higher means speculative decoding is paying off." = "Tokens produits par cycle de décodage avec le modèle brouillon : 1 + tokens brouillon acceptés par cycle. Plus c'est élevé, plus le décodage spéculatif se rentabilise.";
"Requests" = "Requêtes";
"Requests completed since splash started, plus any cancelled or failed." = "Requêtes terminées depuis le démarrage de splash, y compris annulées ou en échec.";
"Prefill" = "Préfill";
"Progress of the prompt being processed now: % done · tokens remaining · estimated time left at the current prefill speed." = "Avancement du prompt en cours : % accompli · tokens restants · temps restant estimé à la vitesse de préfill actuelle.";
" · %@ left" = " · %@ restant";
" · ~%@ left" = " · ~%@ restant";
"Decode" = "Décodage";
"Progress of a request generating now: tokens produced · time spent generating · estimated time left when the request has a max-tokens cap (at the current decode speed)." = "Avancement de la requête en cours de génération : tokens produits · temps passé à générer · temps restant estimé si la requête a une limite de tokens max (à la vitesse de décodage actuelle).";
"TTFT (p50 / p95)" = "TTFT (p50 / p95)";
"Time to first token across requests: median / 95th percentile." = "Temps jusqu'au premier token sur l'ensemble des requêtes : médiane / 95e percentile.";
"ITL (p50 / p95)" = "ITL (p50 / p95)";
"Inter-token latency: the time between consecutive output tokens while generating, across requests (median / 95th percentile). For one stream at a time this is the perceived speed — 1000 ÷ ITL tokens per second — so lower is better." = "Latence inter-tokens : le temps entre deux tokens de sortie consécutifs pendant la génération, sur l'ensemble des requêtes (médiane / 95e percentile). Pour un flux à la fois, c'est la vitesse perçue — 1000 ÷ ITL tokens par seconde — plus c'est bas, mieux c'est.";
"Prefill / decode" = "Préfill / décodage";
"Average speeds since splash started: prompt processing (prefill) / generation (decode)." = "Vitesses moyennes depuis le démarrage de splash : traitement du prompt (préfill) / génération (décodage).";
"Draft accept" = "Acceptation du brouillon";
"Speculative decoding (a draft model proposing tokens ahead) is not in use: the server reports no drafted tokens, so the main model generates every token alone." = "Le décodage spéculatif (un modèle brouillon qui propose des tokens d'avance) n'est pas utilisé : le serveur ne signale aucun token brouillon, le modèle principal génère donc chaque token seul.";
"Speculative decoding: the share of the draft model's proposed tokens the main model accepted (%@ drafted since startup). Higher means the draft pays off; below ~40% it barely helps. LAST REQUEST's Tok/cycle is the same idea per request." = "Décodage spéculatif : part des tokens proposés par le modèle brouillon que le modèle principal a acceptées (%@ proposés depuis le démarrage). Plus c'est élevé, plus le brouillon se rentabilise ; en dessous de ~40 %, il aide à peine. Tok/cycle de DERNIÈRE REQUÊTE est la même idée par requête.";
"Total output" = "Sortie totale";
"Tokens generated across all requests since splash started." = "Tokens générés sur toutes les requêtes depuis le démarrage de splash.";
"Active" = "Actives";
"Requests in flight right now: generating (decode) · processing their prompt (prefill) · waiting their turn (queued), plus how long the longest-waiting request has waited." = "Requêtes en cours en ce moment : génération (décodage) · traitement du prompt (préfill) · en attente de leur tour (file d'attente), plus la durée d'attente de la requête qui attend le plus.";
"splash (server)" = "splash (serveur)";
"Memory the splash server itself currently holds, as it reports it (— when it doesn't), plus its peak since the server started. Different from the RAM bar in the gauges, which is the whole Mac's memory use." = "Mémoire actuellement détenue par le serveur splash lui-même, telle qu'il la rapporte (— s'il ne le fait pas), plus son pic depuis le démarrage du serveur. Différent de la barre RAM des jauges, qui est l'usage mémoire de tout le Mac.";
"KV cache" = "Cache KV";
"KV cache: server memory held for prompt context, and how many prompt tokens were served from it since startup instead of being prefilled again — high reuse is why similar prompts run fast." = "Cache KV : mémoire serveur réservée au contexte du prompt, et combien de tokens du prompt en ont été servis depuis le démarrage au lieu d'être re-préfillés — une forte réutilisation est la raison pour laquelle des prompts similaires tournent vite.";
"Uptime" = "Durée de fonctionnement";
"Time since the server started." = "Temps écoulé depuis le démarrage du serveur.";
"%@ done" = "%@ terminées";
" · %@ cancelled" = " · %@ annulées";
" · %@ failed" = " · %@ en échec";
"idle" = "au repos";
"%lld decode · %lld prefill · %lld queued" = "%lld décodage · %lld préfill · %lld en file";
" · waiting %@" = " · en attente %@";
"%@ · peak %@" = "%@ · pic %@";
"off" = "désactivé";
" · reloading" = " · rechargement";
" · released" = " · libérée";
" · %lld restored" = " · %lld restaurés";
" · %lld failed" = " · %lld en échec";
"How long loading the model weights took at startup, plus their lifecycle. splash releases the weights from memory after %lld s of idleness to give the RAM back, so the next request restores them (\"reloading\") and is slower." = "Durée du chargement des poids du modèle au démarrage, plus leur cycle de vie. splash libère les poids de la mémoire après %lld s d'inactivité pour rendre la RAM ; la requête suivante les restaure (« rechargement ») et est plus lente.";
"How long loading the model weights took at startup, plus their lifecycle. splash can release the weights from memory after idleness to give the RAM back, so the next request restores them (\"reloading\") and is slower." = "Durée du chargement des poids du modèle au démarrage, plus leur cycle de vie. splash peut libérer les poids de la mémoire après inactivité pour rendre la RAM ; la requête suivante les restaure (« rechargement ») et est plus lente.";
" · writes gated" = " · écritures bridées";
"Persistent cache on disk (Settings: --max-cache-disk / --persistent-cache): used / limit." = "Cache persistant sur disque (Réglages : --max-cache-disk / --persistent-cache) : utilisé / limite.";
"Persistent cache on disk (Settings: --max-cache-disk / --persistent-cache): used / limit. \"writes gated\" means splash is pausing cache writes (budget or disk full), so new context may not be cached." = "Cache persistant sur disque (Réglages : --max-cache-disk / --persistent-cache) : utilisé / limite. « écritures bridées » signifie que splash met en pause les écritures du cache (budget ou disque plein), le nouveau contexte peut donc ne pas être mis en cache.";
"age %@ · tick %@" = "âge %@ · tick %@";
"Model" = "Modèle";
"Open in Finder" = "Ouvrir dans Finder";
"Open the folder in the Hugging Face cache where the model's files are stored." = "Ouvrir le dossier du cache Hugging Face où sont stockés les fichiers du modèle.";
"Type any OWNER/REPO[:VARIANT] model in Settings." = "Saisir n'importe quel modèle OWNER/REPO[:VARIANT] dans les Réglages.";
"Switch the splash model to %@?" = "Basculer le modèle splash sur %@ ?";
"The server restarts with it; requests in progress are cancelled." = "Le serveur redémarre avec lui ; les requêtes en cours sont annulées.";
"Switch" = "Basculer";
"The model splash is serving (Hugging Face repo:variant); context window %@ tokens (prompt + output for one request). Click to switch model — the server restarts with it — or open the model's folder in Finder; Custom… opens Settings." = "Le modèle servi par splash (repo Hugging Face :variante) ; fenêtre de contexte de %@ jetons (invite + sortie d'une requête). Cliquez pour changer de modèle — le serveur redémarre avec — ou ouvrir le dossier du modèle dans Finder ; Personnalisé… ouvre les Réglages.";
"Endpoint" = "Endpoint";
"Base URL of the OpenAI-compatible API (add /v1). Click to open it in your browser — splash's chat page lives at this address." = "URL de base de l'API compatible OpenAI (ajouter /v1). Cliquez pour l'ouvrir dans votre navigateur — la page de discussion de splash vit à cette adresse.";
"Stop" = "Arrêter";
"Stop the splash server on this port, including one started outside the app." = "Arrêter le serveur splash sur ce port, y compris s'il a été démarré en dehors de l'app.";
"Restart" = "Redémarrer";
"Stop splash and start it again with the current settings." = "Arrêter splash et le relancer avec les réglages actuels.";
"Start" = "Démarrer";
"Start splash serve with the current settings." = "Démarrer splash serve avec les réglages actuels.";
"Quit" = "Quitter";
"Quit Splash Menu Bar. A server the app started is stopped; one started elsewhere keeps running." = "Quitter Splash Menu Bar. Un serveur démarré par l'app est arrêté ; un serveur démarré ailleurs continue de tourner.";
"Input" = "Entrée";
"Input types this server accepts in prompts." = "Types d'entrée acceptés par ce serveur dans les prompts.";
"ANE" = "ANE";
"How the model's FFN (feed-forward) layers are split between the Apple Neural Engine (ANE) and the GPU: the percentage is the ANE's share of the work. ane = all on the ANE, split = shared, gpu = none (e.g. --disable-ane)." = "Comment les couches FFN (feed-forward) du modèle sont réparties entre la Apple Neural Engine (ANE) et le GPU : le pourcentage est la part de travail de l'ANE. ane = tout sur l'ANE, split = partagé, gpu = aucune (par ex. --disable-ane).";
"SSD cache" = "Cache SSD";
"Health" = "État";
"splash's self-report: how old its own status snapshot is (it refreshes every event-loop tick, so normally ~0), and the longest loop tick since startup. A stale snapshot or a long tick means the server's loop is slow or blocked and requests stall." = "Auto-rapport de splash : l'âge de sa propre instantanée d'état (rafraîchie à chaque tick de la boucle d'événements, donc normalement ~0) et le tick de boucle le plus long depuis le démarrage. Une instantanée périmée ou un tick long signifie que la boucle du serveur est lente ou bloquée et que les requêtes stagnent.";
