"You have splash %@. This runs:\n    brew upgrade %@\nA progress window shows what Homebrew is doing." = "Tens o splash %@. Isto executa:\n    brew upgrade %@\nUma janela de progresso mostra o que o Homebrew está a fazer.";
"Homebrew not found" = "Homebrew não encontrado";
