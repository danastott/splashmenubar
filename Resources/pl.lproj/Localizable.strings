"App" = "Aplikacja";
"About" = "O programie";
"Reset to defaults" = "Przywróć domyślne";
"Set every option to its default. Nothing is saved or restarted until you press Save." = "Ustaw każdą opcję na wartość domyślną. Nic nie zostanie zapisane ani ponownie uruchomione, dopóki nie naciśniesz Zapisz.";
"Cancel" = "Anuluj";
"Close without saving." = "Zamknij bez zapisywania.";
"Save" = "Zapisz";
"Save these options to ~/.splashmenubar.json and restart splash with them." = "Zapisz te opcje do ~/.splashmenubar.json i uruchom splash ponownie z nimi.";
