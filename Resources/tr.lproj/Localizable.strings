"State format" = "Durum biçimi";
"fp32 (default)" = "fp32 (varsayılan)";
"--state-format: storage for recurrent state. fp32 (default); bf16 halves each state, so memory and the SSD cache hold about twice as many." = "--state-format: yinelemeli durum için depolama. fp32 (varsayılan); bf16 her durumu yarıya indirir, böylece bellek ve SSD önbelleği yaklaşık iki katı tutar.";
"Max cache disk" = "Maks. önbellek disk";
"auto (e.g. 16G; 0 = off)" = "oto (örn. 16G; 0 = kapalı)";
"--max-cache-disk: SSD quota for cached KV pages and states, e.g. 16G; 0 disables the SSD cache. Blank = auto (a quarter of free space, at most 32G)." = "--max-cache-disk: önbelleğe alınan KV sayfaları ve durumlar için SSD kotası, örn. 16G; 0 SSD önbelleğini kapatır. Boş = oto (boş alanın dörtte biri, en fazla 32G).";
"Language only" = "Yalnız dil";
"--language-only: skip loading vision; image and PDF input is refused. Saves memory and startup time." = "--language-only: görme bileşeninin yüklenmesini atla; görüntü ve PDF girdisi reddedilir. Bellek ve açılış süresinden tasarruf eder.";
"Disable Neural Engine" = "Nöral Motoru Devre Dışı Bırak";
