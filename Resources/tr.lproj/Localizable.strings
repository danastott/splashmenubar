"Persistent cache" = "Kalıcı önbellek";
"--persistent-cache: keep the SSD prompt cache across restarts, so earlier conversations resume without re-prefilling." = "--persistent-cache: yeniden başlatmalar arasında SSD prompt önbelleğini koru, böylece önceki konuşmalar yeniden prefill'lanmadan devam eder.";
