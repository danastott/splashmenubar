// Deutsche Strings für SplashMenuBar.
// Key = the key Foundation derives from the Swift source literal;
// value = the English text. Translate a language by copying this file
// into <lang>.lproj/Localizable.strings and replacing the values.

"DECODE SPEED · TOK/S" = "DEKODIERGESCHWINDIGKEIT · TOK/S";
"Decode speed (tok/s): the last %lld samples taken while a request is generating, every %@ (span and UI refresh in Settings). Samples are evenly spaced by count, not by wall-clock time — idle gaps don't stretch them. The dotted line is the average of the samples shown. Right-click to pick the line's color." = "Dekodiergeschwindigkeit (tok/s): die letzten während der Generierung einer Anfrage erfassten %lld Stichproben, alle %@ (Zeitraum und UI-Aktualisierung in den Einstellungen). Die Stichproben sind nach Anzahl gleichmäßig verteilt, nicht nach Uhrzeit — Leerlaufphasen dehnen sie nicht. Die gestrichelte Linie ist der Durchschnitt der gezeigten Stichproben. Rechtsklick, um die Farbe der Linie zu wählen.";
"LAST REQUEST" = "LETZTER REQUEST";
"Figures for the most recently finished request, from splash's Done log line." = "Werte der zuletzt abgeschlossenen Anfrage, aus der Done-Zeile im splash-Log.";
"LOAD" = "LAST";
"Server-wide totals and averages since splash started." = "Serverweite Summen und Durchschnittswerte seit splash gestartet wurde.";
"SERVER" = "SERVER";
"What splash is serving and where." = "Was splash bereitstellt und wo.";
"external" = "extern";
"This server wasn't started by Splash Menu Bar (e.g. run from a terminal). Stop still shuts it down; quitting the app leaves it running." = "Dieser Server wurde nicht von Splash Menu Bar gestartet (z. B. per Terminal). „Stoppen“ beendet ihn trotzdem; beim Beenden der App läuft er weiter.";
"Unpin" = "Lösen";
"Pin" = "Anheften";
"Pinned: this panel stays open until you unpin it, and you can drag it anywhere by its top edge. Click to unpin and snap it back under the menu bar." = "Angeheftet: Dieses Panel bleibt geöffnet, bis Sie es lösen. Sie können es am oberen Rand an beliebige Stelle ziehen. Klicken, um es zu lösen und unter die Menüleiste zurückzugleiten.";
"Pin this panel open, so clicking elsewhere, pressing Esc or using its buttons doesn't close it. Pinned, you can drag it anywhere on screen by its top edge." = "Dieses Panel angeheftet halten, sodass ein Klick woanders, die Esc-Taste oder die Nutzung der Schaltflächen es nicht schließt. Angeheftet lässt es sich am oberen Rand an beliebige Stelle auf dem Bildschirm ziehen.";
"Settings (⌘,): edit the splash serve options. Saving restarts the server." = "Einstellungen (⌘,): splash-Server-Optionen bearbeiten. Speichern startet den Server neu.";
"Starting splash…" = "splash wird gestartet…";
"What splash is doing before it can serve: the current stage, download progress (size · speed · time left), time since launch, and its latest output line." = "Was splash tut, bevor es bereit ist: aktueller Schritt, Download-Fortschritt (Größe · Geschwindigkeit · verbleibende Zeit), Zeit seit dem Start und die neueste Ausgabezeile.";
"splash exited" = "splash beendet";
"splash exited: %@. The lines below are its last output; select the text to copy it. Press Start to run it again." = "splash beendet: %@. Die folgenden Zeilen sind seine letzte Ausgabe; Text markieren, um ihn zu kopieren. „Starten“ drücken, um es erneut auszuführen.";
"A splash server started outside the app is serving port %lld, so the app uses that one. Restart runs splash from the app instead." = "Ein außerhalb der App gestarteter splash-Server bedient Port %lld, daher nutzt die App diesen. „Neu starten“ führt stattdessen splash aus der App aus.";
"The splash this app started exited, but an externally started splash is serving port %lld — the app is using that server. Restart shuts it down and runs splash from the app with the current settings." = "Der von dieser App gestartete splash wurde beendet, aber ein extern gestarteter splash bedient Port %lld — die App nutzt diesen Server. „Neu starten“ schaltet ihn aus und führt splash aus der App mit den aktuellen Einstellungen aus.";
"port in use" = "Port belegt";
"Something else (not splash) is serving port %lld, so the splash the app started exited. Stop that service — or change the port in Settings — then press Start." = "Irgend etwas anderes (nicht splash) bedient Port %lld, daher wurde der von der App gestartete splash beendet. Beenden Sie diesen Dienst — oder ändern Sie den Port in den Einstellungen — und drücken Sie dann „Starten“.";
"A service other than splash is listening on port %lld — the splash this app started exited because the port was taken. Stop the other service or change the port in Settings." = "Ein anderer Dienst als splash lauscht auf Port %lld — der von dieser App gestartete splash wurde beendet, weil der Port belegt war. Beenden Sie den anderen Dienst oder ändern Sie den Port in den Einstellungen.";
"splash %@ available" = "splash %@ verfügbar";
"Update Splash" = "Splash aktualisieren";
"Confirm and update splash to %@ through Homebrew; afterwards the server can be restarted onto it." = "Bestätigen und splash über Homebrew auf %@ aktualisieren; anschließend kann der Server darauf neu gestartet werden.";
"the newest version" = "die neueste Version";
"Installed: %@. The update runs `brew upgrade %@`." = "Installiert: %@. Das Update führt `brew upgrade %@` aus.";
"A newer splash release is available. Update Splash runs brew upgrade for the splash formula; the server restarts only if you confirm it afterwards." = "Eine neuere splash-Version ist verfügbar. „Splash aktualisieren“ führt brew upgrade für die splash-Formel aus; der Server startet nur neu, wenn Sie es anschließend bestätigen.";
"Splash Menu Bar %@ available" = "Splash Menu Bar %@ verfügbar";
"Update App" = "App aktualisieren";
"Confirm and update Splash Menu Bar to %@ through Homebrew; the app relaunches afterwards." = "Bestätigen und Splash Menu Bar über Homebrew auf %@ aktualisieren; die App wird anschließend neu gestartet.";
"Installed: %@. The update runs `brew upgrade --cask splashmenubar`." = "Installiert: %@. Das Update führt `brew upgrade --cask splashmenubar` aus.";
"A newer Splash Menu Bar release is available. Update App runs brew upgrade for the splashmenubar cask; the app relaunches onto it." = "Eine neuere Splash Menu Bar-Version ist verfügbar. „App aktualisieren“ führt brew upgrade für das splashmenubar-Cask aus; die App startet darauf neu.";
"Get started" = "Loslegen";
"Dismiss tip" = "Hinweis ausblenden";
"Hide this tip." = "Diesen Hinweis ausblenden.";
"No splash server is running. Open Settings to choose a splash model, then press ▶ Start. To have the server start whenever the app launches, turn on Start 'splash' server on launch." = "Kein splash-Server läuft. Öffnen Sie die Einstellungen, um ein splash-Modell zu wählen, und drücken Sie dann ▶ Starten. Damit der Server beim Start der App automatisch startet, aktivieren Sie „'splash'-Server beim Start starten“.";
"Open Settings…" = "Einstellungen öffnen…";
"Choose a model and other splash options." = "Modell und andere splash-Optionen wählen.";
"Engine error" = "Engine-Fehler";
"Metal is reporting a failure; requests may fail or hang until splash is restarted.%@" = "Metal meldet einen Fehler; Anfragen können fehlschlagen oder hängen, bis splash neu gestartet wird.%@";
"Engine recovering" = "Engine stellt sich wieder her";
"The inference engine crashed and is restarting; requests can't be served until it's back.%@" = "Die Inferenz-Engine ist abgestürzt und wird neu gestartet; Anfragen können erst bedient werden, wenn sie wieder läuft.%@";
"Engine unstable" = "Engine instabil";
"The inference engine has crashed and restarted since startup;%@ if it keeps happening, restart splash." = "Die Inferenz-Engine ist seit dem Start abgestürzt und neu gestartet;%@ Wenn es weiter geschieht, splash neu starten.";
" Restarted %lld× since startup." = " %lld× Neustarts seit Start.";
"Yellow: splash is starting (downloading or loading the model)." = "Gelb: splash wird gestartet (Modell wird heruntergeladen oder geladen).";
"Green: splash is running and ready for requests." = "Grün: splash läuft und ist bereit für Anfragen.";
"Green: splash is running." = "Grün: splash läuft.";
"Red: splash exited unexpectedly (%@). Press Start to run it again." = "Rot: splash wurde unerwartet beendet (%@). „Starten“ drücken, um es erneut auszuführen.";
"Gray: splash is stopped. Press Start to run it." = "Grau: splash ist gestoppt. „Starten“ drücken, um es auszuführen.";
"Thermal state of this Mac: macOS's system-wide thermal-pressure state, reported to the app through splash.\n%@\nLevels: nominal → fair → serious → critical.\nThe OS sets it from the whole system and changes it slowly, so it can temporarily disagree with the chip temperature shown next to it." = "Thermischer Zustand dieses Macs: systemweiter thermischer Druckzustand von macOS, der der App über splash gemeldet wird.\n%@\nStufen: nominal → fair → serious → critical.\nDas Betriebssystem setzt ihn für das gesamte System und ändert ihn nur langsam — er kann daher kurzzeitig von der daneben gezeigten Chip-Temperatur abweichen.";
"Chip temperature: %@ — the hottest CPU/GPU die sensor, read directly by the app (not from splash). The unit follows the Temperature setting; System uses the computer's region." = "Chip-Temperatur: %@ — der heißeste CPU-/GPU-Die-Sensor, direkt von der App ausgelesen (nicht von splash). Die Einheit folgt der Temperatur-Einstellung; System nutzt die Region des Computers.";
"Nominal: normal temperature, no thermal limits." = "Nominal: normale Temperatur, keine thermischen Limits.";
"Fair: slightly warm. Fans may spin up and macOS may trim background work; speeds are usually unaffected." = "Fair: leicht warm. Lüfter können hochdrehen und macOS Hintergrundarbeit drosseln; Geschwindigkeiten bleiben in der Regel unverändert.";
"Serious: hot. macOS is throttling the CPU and GPU, so tok/s and prefill speed will drop." = "Serious: heiß. macOS drosselt CPU und GPU, daher fallen tok/s und Prefill-Geschwindigkeit.";
"Critical: very hot. Heavy throttling until the Mac cools down." = "Critical: sehr heiß. Starke Drosselung, bis der Mac abkühlt.";
"Current state: %@." = "Aktueller Zustand: %@.";
"tok/s" = "tok/s";
"Decode speed: tokens generated per second right now, or the average since splash started when idle. The ring auto-scales to the speed graph's window: full ring = a round number at or above the highest tok/s it shows (the graph's top gridline), so 180 tok/s reads instead of pinning the ring. Below the value: the average of the samples the speed graph shows (its dotted line). Right-click to pick the ring's color." = "Dekodiergeschwindigkeit: aktuell pro Sekunde generierte Token bzw. bei Leerlauf der Durchschnitt seit splash gestartet wurde. Der Ring skaliert automatisch auf das Fenster des Geschwindigkeitsdiagramms: voller Ring = eine runde Zahl auf oder über dem höchsten angezeigten tok/s (oberste Gitterlinie des Diagramms), sodass 180 tok/s lesbar sind, statt den Ring an der Grenze zu halten. Unter dem Wert: Durchschnitt der vom Geschwindigkeitsdiagramm gezeigten Stichproben (gestrichelte Linie). Rechtsklick, um die Farbe des Rings zu wählen.";
"prefill" = "prefill";
"While a prompt is prefilling: how much of it is done (the ring fills as it goes) and the estimated time left. Otherwise: prefill speed in tokens per second, from the last prefill or the average since splash started; a full ring = 500 tok/s. Right-click to pick the ring's color." = "Während ein Prompt geprefillt wird: wie viel davon erledigt ist (der Ring füllt sich mit dem Fortschritt) und die geschätzte Restzeit. Ansonsten: Prefill-Geschwindigkeit in Token pro Sekunde, aus dem letzten Prefill oder dem Durchschnitt seit splash gestartet wurde; voller Ring = 500 tok/s. Rechtsklick, um die Farbe des Rings zu wählen.";
"cached" = "gecacht";
"KV cache hit rate since the server started: the share of prompt tokens served from the cache instead of being prefilled again (the per-request figure is LAST REQUEST → Input / cached). Right-click to pick the ring's color." = "KV-Cache-Trefferquote seit Serverstart: Anteil der Prompt-Token, die aus dem Cache bedient wurden, statt erneut geprefillt zu werden (der Wert pro Anfrage ist LETZTER REQUEST → Eingabe / gecacht). Rechtsklick, um die Farbe des Rings zu wählen.";
"GPU" = "GPU";
"GPU use across the whole Mac: share of time the GPU was busy, as Activity Monitor reports it. Right-click to pick the bar's color." = "GPU-Nutzung auf dem ganzen Mac: Anteil der Zeit, in der die GPU beschäftigt war, wie Activity Monitor ihn meldet. Rechtsklick, um die Farbe der Leiste zu wählen.";
"CPU" = "CPU";
"CPU use across the whole Mac: share of all cores' time spent busy since the last refresh. Right-click to pick the bar's color." = "CPU-Nutzung auf dem ganzen Mac: Anteil der Zeit aller Kerne, die seit der letzten Aktualisierung mit Arbeit verbracht wurde.";
"RAM" = "RAM";
"Memory used across the whole Mac (app memory + wired + compressed, as Activity Monitor counts it): %@ of %@" = "Genutzter Speicher auf dem ganzen Mac (App-Speicher + wired + komprimiert, wie Activity Monitor ihn zählt): %@ von %@";
"Memory used across the whole Mac (app memory + wired + compressed, as Activity Monitor counts it)" = "Genutzter Speicher auf dem ganzen Mac (App-Speicher + wired + komprimiert, wie Activity Monitor ihn zählt)";
"%@. The bar's color follows the server's memory-pressure report — %@" = "%@. Die Farbe der Leiste folgt dem Memory-Pressure-Report des Servers — %@";
"green = normal, yellow = warning, red = critical" = "grün = normal, gelb = Warnung, rot = kritisch";
"%@; the server hasn't reported one yet." = "%@; der Server hat noch keinen gemeldet.";
"normal — the Mac has memory to spare" = "normal — der Mac hat Speicherreserven";
"warning — the system is under memory load; splash's requests may be slower or suspended" = "Warnung — das System ist unter Speicherauslastung; splash-Anfragen können langsamer sein oder angehalten werden";
"critical — macOS is reclaiming memory aggressively; splash may refuse or drop requests until it eases off" = "kritisch — macOS gibt Speicher aggressiv frei; splash kann Anfragen ablehnen oder verwerfen, bis es nachlässt";
"%@; right now: %@" = "%@; aktuell: %@";
"Output (last)" = "Ausgabe (letzte)";
"Tokens the last request generated." = "Token der letzten generierten Anfrage.";
"Input / cached" = "Eingabe / gecacht";
"Prompt tokens of the last request / how many of them were reused from the prompt cache instead of being prefilled again. Of the uncached rest, a further share could still read KV that other requests had already computed — the niche \"deduplicated\" figure, no longer shown as its own row." = "Prompt-Token der letzten Anfrage / wie viele davon aus dem Prompt-Cache wiederverwendet wurden, statt erneut geprefillt zu werden. Vom nicht gecachteten Rest konnte ein weiterer Anteil KV lesen, den andere Anfragen bereits berechnet hatten — die Nischen-„deduplicated“-Zahl, die nicht mehr als eigene Zeile angezeigt wird.";
"TTFT (last)" = "TTFT (letzter)";
"Time to first token of the last request: from arrival until its first output token (mostly prefill)." = "Zeit bis zum ersten Token der letzten Anfrage: vom Eintreffen bis zu ihrem ersten Output-Token (vornehmlich Prefill).";
"Tok/cycle" = "Tok/Zyklus";
"Tokens produced per decode cycle with the draft model: 1 + accepted draft tokens per cycle. Higher means speculative decoding is paying off." = "Erzeugte Token pro Dekodierzyklus mit dem Draft-Modell: 1 + akzeptierte Draft-Token pro Zyklus. Höher heißt, dass spekulatives Dekodieren sich lohnt.";
"Requests" = "Anfragen";
"Requests completed since splash started, plus any cancelled or failed." = "Seit splash gestartet wurde abgeschlossene Anfragen, dazu stornierte oder fehlgeschlagene.";
"Prefill" = "Prefill";
"Progress of the prompt being processed now: % done · tokens remaining · estimated time left at the current prefill speed." = "Fortschritt des gerade verarbeiteten Prompts: % fertig · verbleibende Token · geschätzte Restzeit bei der aktuellen Prefill-Geschwindigkeit.";
" · %@ left" = " · %@ verbleibend";
" · ~%@ left" = " · ~%@ verbleibend";
"Decode" = "Dekodieren";
"Progress of a request generating now: tokens produced · time spent generating · estimated time left when the request has a max-tokens cap (at the current decode speed)." = "Fortschritt der gerade generierenden Anfrage: erzeugte Token · verstrichene Generierungszeit · geschätzte Restzeit, wenn die Anfrage ein Max-Tokens-Limit hat (bei aktueller Dekodiergeschwindigkeit).";
"TTFT (p50 / p95)" = "TTFT (p50 / p95)";
"Time to first token across requests: median / 95th percentile." = "Zeit bis zum ersten Token über alle Anfragen: Median / 95. Perzentil.";
"ITL (p50 / p95)" = "ITL (p50 / p95)";
"Inter-token latency: the time between consecutive output tokens while generating, across requests (median / 95th percentile). For one stream at a time this is the perceived speed — 1000 ÷ ITL tokens per second — so lower is better." = "Inter-Token-Latenz: die Zeit zwischen aufeinanderfolgenden Output-Token während der Generierung, über alle Anfragen (Median / 95. Perzentil). Bei einem Stream gleichzeitig ist dies die wahrgenommene Geschwindigkeit — 1000 ÷ ITL Token pro Sekunde — also ist niedriger besser.";
"Prefill / decode" = "Prefill / Dekodieren";
"Average speeds since splash started: prompt processing (prefill) / generation (decode)." = "Durchschnittsgeschwindigkeiten seit splash gestartet wurde: Promptverarbeitung (Prefill) / Generierung (Dekodieren).";
"Draft accept" = "Draft-Akzeptanz";
"Speculative decoding (a draft model proposing tokens ahead) is not in use: the server reports no drafted tokens, so the main model generates every token alone." = "Spekulatives Dekodieren (ein Draft-Modell schlägt Token vorab vor) wird nicht verwendet: Der Server meldet keine drafted Token, daher generiert das Hauptmodell jedes Token allein.";
"Speculative decoding: the share of the draft model's proposed tokens the main model accepted (%@ drafted since startup). Higher means the draft pays off; below ~40% it barely helps. LAST REQUEST's Tok/cycle is the same idea per request." = "Spekulatives Dekodieren: Anteil der vom Draft-Modell vorgeschlagenen Token, die das Hauptmodell akzeptiert hat (%@ draft seit Start). Höher bedeutet, dass sich der Draft lohnt; unter ~40 % bringt er kaum etwas. LETZTER REQUEST → Tok/Zyklus ist dasselbe pro Anfrage.";
"Total output" = "Gesamtoutput";
"Tokens generated across all requests since splash started." = "Seit splash gestartet wurde über alle Anfragen generierten Token.";
"Active" = "Aktiv";
"Requests in flight right now: generating (decode) · processing their prompt (prefill) · waiting their turn (queued), plus how long the longest-waiting request has waited." = "Aktuell laufende Anfragen: generierend (Dekodieren) · Promptverarbeitung (Prefill) · wartet auf die Reihe (in Warteschlange), plus wie lange die am längsten wartende Anfrage wartet.";
"splash (server)" = "splash (Server)";
"Memory the splash server itself currently holds, as it reports it (— when it doesn't), plus its peak since the server started. Different from the RAM bar in the gauges, which is the whole Mac's memory use." = "Speicher, den der splash-Server selbst aktuell hält, wie er ihn meldet (— wenn er es nicht tut), plus sein Höchstwert seit Serverstart. Unterschied zur RAM-Leiste in den Tachos, die den Speicherverbrauch des ganzen Macs zeigt.";
"KV cache" = "KV-Cache";
"KV cache: server memory held for prompt context, and how many prompt tokens were served from it since startup instead of being prefilled again — high reuse is why similar prompts run fast." = "KV-Cache: Server-Speicher, der für den Prompt-Kontext gehalten wird, und wie viele Prompt-Token seit dem Start aus ihm bedient wurden, statt erneut geprefillt zu werden — hohe Wiederverwendung ist der Grund, warum ähnliche Prompts schnell laufen.";
"Uptime" = "Laufzeit";
"Time since the server started." = "Zeit seit dem Serverstart.";
"%@ done" = "%@ erledigt";
" · %@ cancelled" = " · %@ storniert";
" · %@ failed" = " · %@ fehlgeschlagen";
"idle" = "Leerlauf";
"%lld decode · %lld prefill · %lld queued" = "%lld Dekodieren · %lld Prefill · %lld in Warteschlange";
" · waiting %@" = " · wartet %@";
"%@ · peak %@" = "%@ · Höchstwert %@";
"off" = "aus";
" · reloading" = " · wird neu geladen";
" · released" = " · freigegeben";
" · %lld restored" = " · %lld wiederhergestellt";
" · %lld failed" = " · %lld fehlgeschlagen";
"How long loading the model weights took at startup, plus their lifecycle. splash releases the weights from memory after %lld s of idleness to give the RAM back, so the next request restores them (\"reloading\") and is slower." = "Wie lange das Laden der Modellgewichte beim Start dauerte, plus deren Lebenszyklus. splash gibt die Gewichte aus dem Speicher nach %lld s Leerlauf frei, um RAM freizugeben, daher stellt die nächste Anfrage sie wieder her („reloading“) und ist langsamer.";
"How long loading the model weights took at startup, plus their lifecycle. splash can release the weights from memory after idleness to give the RAM back, so the next request restores them (\"reloading\") and is slower." = "Wie lange das Laden der Modellgewichte beim Start dauerte, plus deren Lebenszyklus. splash kann die Gewichte aus dem Speicher nach Leerlauf freigeben, um RAM freizugeben, daher stellt die nächste Anfrage sie wieder her („reloading“) und ist langsamer.";
" · writes gated" = " · Schreibzugriffe kontrolliert";
"Persistent cache on disk (Settings: --max-cache-disk / --persistent-cache): used / limit." = "Dauerhafter Cache auf der Platte (Einstellungen: --max-cache-disk / --persistent-cache): belegt / Limit.";
"Persistent cache on disk (Settings: --max-cache-disk / --persistent-cache): used / limit. \"writes gated\" means splash is pausing cache writes (budget or disk full), so new context may not be cached." = "Dauerhafter Cache auf der Platte (Einstellungen: --max-cache-disk / --persistent-cache): belegt / Limit. „Schreibzugriffe kontrolliert“ bedeutet, dass splash Cache-Schreibvorgänge pausiert (Budget oder Platte voll), daher wird neuer Kontext möglicherweise nicht gecacht.";
"age %@ · tick %@" = "Alter %@ · Tick %@";
"Model" = "Modell";
"The model splash is serving (Hugging Face repo:variant); context window %@ tokens (prompt + output for one request). Change it in Settings." = "Das Modell, das splash bereitstellt (Hugging Face Repo:Variante); Kontextfenster %@ Token (Prompt + Output für eine Anfrage). In den Einstellungen ändern.";
"The model splash is serving (Hugging Face repo:variant); context window %@ tokens (prompt + output for one request). Change it in Settings. Click to open the folder where its files are stored in Finder." = "Das Modell, das splash bereitstellt (Hugging Face Repo:Variante); Kontextfenster %@ Token (Prompt + Output für eine Anfrage). In den Einstellungen ändern. Klicken, um den Ordner zu öffnen, in dem seine Dateien in Finder abgelegt sind.";
"Endpoint" = "Endpunkt";
"Base URL of the OpenAI-compatible API (add /v1). Click to open it in your browser — splash's chat page lives at this address." = "Basis-URL der OpenAI-kompatiblen API (/v1 anfügen). Klicken, um sie im Browser zu öffnen — splash' Chat-Seite befindet sich unter dieser Adresse.";
"Stop" = "Stoppen";
"Stop the splash server on this port, including one started outside the app." = "Den splash-Server auf diesem Port stoppen, auch wenn er außerhalb der App gestartet wurde.";
"Restart" = "Neu starten";
"Stop splash and start it again with the current settings." = "splash stoppen und mit den aktuellen Einstellungen neu starten.";
"Start" = "Starten";
"Start splash serve with the current settings." = "splash serve mit den aktuellen Einstellungen starten.";
"Quit" = "Beenden";
"Quit Splash Menu Bar. A server the app started is stopped; one started elsewhere keeps running." = "Splash Menu Bar beenden. Ein von der App gestarteter Server wird gestoppt; einer, der woanders gestartet wurde, läuft weiter.";
"Input" = "Eingabe";
"Input types this server accepts in prompts." = "Eingabetypen, die dieser Server in Prompts akzeptiert.";
"ANE" = "ANE";
"How the model's FFN (feed-forward) layers are split between the Apple Neural Engine (ANE) and the GPU: the percentage is the ANE's share of the work. ane = all on the ANE, split = shared, gpu = none (e.g. --disable-ane)." = "Wie die FFN-(Feed-Forward-)Schichten des Modells zwischen Apple Neural Engine (ANE) und GPU aufgeteilt sind: Der Prozentsatz ist der ANE-Anteil der Arbeit. ane = alles auf der ANE, split = geteilt, gpu = gar nichts (z. B. --disable-ane).";
"SSD cache" = "SSD-Cache";
"Health" = "Status";
"splash's self-report: how old its own status snapshot is (it refreshes every event-loop tick, so normally ~0), and the longest loop tick since startup. A stale snapshot or a long tick means the server's loop is slow or blocked and requests stall." = "splash' Selbstreport: Wie alt sein eigener Status-Snapshot ist (wird bei jedem Event-Loop-Tick aktualisiert, daher normalerweise ~0) und der längste Loop-Tick seit dem Start. Ein veralteter Snapshot oder ein langer Tick bedeutet, dass die Server-Schleife langsam oder blockiert ist und Anfragen stocken.";
"Weights" = "Gewichte";
"avg %@" = "Ø %@";
"no decode samples yet" = "noch keine Dekodier-Stichproben";
"Color…" = "Farbe…";
"AI harness" = "KI-Harness";
"Server" = "Server";
"App" = "App";
"About" = "Über";
"Reset to defaults" = "Auf Standard zurücksetzen";
"Set every option to its default. Nothing is saved or restarted until you press Save." = "Jede Option auf ihren Standardwert setzen. Es wird nichts gespeichert oder neu gestartet, bis Sie „Speichern“ drücken.";
"Cancel" = "Abbrechen";
"Close without saving." = "Schließen ohne zu speichern.";
"Save" = "Speichern";
"Save these options to ~/.splashmenubar.json and restart splash with them." = "Diese Optionen in ~/.splashmenubar.json speichern und splash mit ihnen neu starten.";
"--model: a supported model, or Custom… for any Hugging Face model as OWNER/REPO[:VARIANT] with the GGUF variant after ':'. Downloaded models are found in the Hugging Face cache; others download on first start, along with their draft." = "--model: ein unterstütztes Modell oder „Custom…“ für jedes Hugging Face-Modell als OWNER/REPO[:VARIANT] mit der GGUF-Variante nach ':'. Heruntergeladene Modelle befinden sich im Hugging Face-Cache; andere werden beim ersten Start zusammen mit ihrem Draft heruntergeladen.";
"OWNER/REPO[:VARIANT]" = "OWNER/REPO[:VARIANT]";
"Model %@" = "Modell %@";
"Needs about %lld GB of RAM — this Mac has %lld GB, so this model will likely not run here" = "Benötigt etwa %lld GB RAM — dieser Mac hat %lld GB, daher wird dieses Modell hier wahrscheinlich nicht laufen";
"Downloaded" = "Heruntergeladen";
"Not downloaded" = "Nicht heruntergeladen";
"%@ — %@" = "%@ — %@";
"%@ · %lld GB download" = "%@ · Download %lld GB";
"Custom…" = "Eigene…";
"Downloaded · %@ on disk" = "Heruntergeladen · %@ auf der Platte";
"Open in Finder the folder where this model is stored (the Hugging Face cache)." = "Im Finder den Ordner öffnen, in dem dieses Modell gespeichert ist (der Hugging Face-Cache).";
"Not downloaded · the first start downloads it" = "Nicht heruntergeladen · der erste Start lädt es herunter";
"Checking the model cache…" = "Modell-Cache wird geprüft…";
"Manage…" = "Verwalten…";
"The Hugging Face cache (~/.cache/huggingface/hub) where splash keeps downloaded models, including the separate versions of a repo it has fetched. Manage lists them, downloads new models, and removes what's no longer wanted." = "Der Hugging Face-Cache (~/.cache/huggingface/hub), in dem splash heruntergeladene Modelle aufbewahrt, einschließlich der separaten Versionen eines Repos, das es geholt hat. „Verwalten…“ listet sie auf, lädt neue Modelle herunter und entfernt, was nicht mehr benötigt wird.";
"Pin model version" = "Modellversion anheften";
"--revision: pin splash to the commit of the model already in the Hugging Face cache, so a new commit on the repository's default branch is not re-downloaded over the copy on disk. Off by default, when splash follows the default branch. With no complete copy in the cache there is no version to pin, so the first start downloads as usual and only restarts after are pinned." = "--revision: splash an den Commit des Modells im Hugging Face-Cache anheften, damit ein neuer Commit auf dem Standardzweig des Repositories nicht über die Kopie auf der Platte neu heruntergeladen wird. Standardmäßig aus, dann folgt splash dem Standardzweig. Ohne komplette Kopie im Cache gibt es keine Version zum Anheften, daher lädt der erste Start wie gewohnt herunter und nur Neustarts danach sind angeheftet.";
"Point a coding harness at the splash server. Auto Connect writes the harness's own configuration, so it uses splash from a terminal too; start it in a new session after connecting. Every supported harness is listed; the uninstalled ones can be connected once their binary is on the PATH." = "Ein Coding-Harness auf den splash-Server zeigen. „Automatisch verbinden“ schreibt die eigene Konfiguration des Harness, sodass es splash auch aus einem Terminal nutzt; danach in einer neuen Session starten. Alle unterstützten Harnesses sind aufgelistet; die nicht installierten lassen sich verbinden, sobald ihre Binärdatei im PATH ist.";
"%@ (not installed)" = "%@ (nicht installiert)";
"Connecting…" = "Wird verbunden…";
"Auto Connect" = "Automatisch verbinden";
"Install it to connect it — Auto Connect writes the harness's own configuration." = "Installieren, um es zu verbinden — „Automatisch verbinden“ schreibt die eigene Konfiguration des Harness.";
"Port" = "Port";
"8000" = "8000";
"--port: HTTP port the server listens on (127.0.0.1)." = "--port: HTTP-Port, auf dem der Server lauscht (127.0.0.1).";
"Port %@" = "Port %@";
"Max memory" = "Max. Speicher";
"auto (e.g. 28G)" = "auto (z. B. 28G)";
"--max-memory: Metal memory budget, e.g. 28G. It can only lower the automatic budget. Blank = auto." = "--max-memory: Metal-Speicherbudget, z. B. 28G. Es kann nur das automatische Budget senken. Leer = auto.";
"Idle release" = "Leerlauf-Freigabe";
"10m default (e.g. off)" = "10m Standard (z. B. off)";
"--idle-release: time without a request before splash frees the model weights and memory, e.g. 30m, 1h; off keeps them loaded. Blank = 10m." = "--idle-release: Zeit ohne Anfragen, bis splash die Modellgewichte und den Speicher freigibt, z. B. 30m, 1h; off lässt sie geladen. Leer = 10m.";
"Max context" = "Max. Kontext";
"auto (e.g. 100K)" = "auto (z. B. 100K)";
"--max-context: context token limit, e.g. 100K or 1M. Past the model's native window (256K) it turns on YaRN, which changes answers, so go higher only when needed. Blank = auto." = "--max-context: Kontext-Token-Limit, z. B. 100K oder 1M. Über dem nativen Fenster des Modells (256K) aktiviert es YaRN, was Antworten verändert — also nur erhöhen, wenn nötig. Leer = auto.";
"KV format" = "KV-Format";
"int8 (default)" = "int8 (Standard)";
"bf16" = "bf16";
"--kv-format: storage for the KV cache. int8 (default) uses less memory; bf16 uses more." = "--kv-format: Speicherformat für den KV-Cache. int8 (Standard) nutzt weniger Speicher; bf16 mehr.";
"State format" = "Zustandsformat";
"fp32 (default)" = "fp32 (Standard)";
"--state-format: storage for recurrent state. fp32 (default); bf16 halves each state, so memory and the SSD cache hold about twice as many." = "--state-format: Speicherformat für den rekurrenten Zustand. fp32 (Standard); bf16 halbiert jeden Zustand, sodass Speicher und SSD-Cache etwa doppelt so viele fassen.";
"Max cache disk" = "Cache-Platte max";
"auto (e.g. 16G; 0 = off)" = "auto (z. B. 16G; 0 = off)";
"--max-cache-disk: SSD quota for cached KV pages and states, e.g. 16G; 0 disables the SSD cache. Blank = auto (a quarter of free space, at most 32G)." = "--max-cache-disk: SSD-Quota für gecachte KV-Seiten und Zustände, z. B. 16G; 0 deaktiviert den SSD-Cache. Leer = auto (ein Viertel des freien Platzes, höchstens 32G).";
"Language only" = "Nur Sprache";
"--language-only: skip loading vision; image and PDF input is refused. Saves memory and startup time." = "--language-only: Laden der Vision überspringen; Bild- und PDF-Eingabe wird abgelehnt. Spart Speicher und Startzeit.";
"Disable Neural Engine" = "Neural Engine deaktivieren";
"--disable-ane: prefill on the GPU alone. By default long prompts on dense models also use the Neural Engine when that's faster." = "--disable-ane: Prefill nur auf der GPU. Standardmäßig nutzen lange Prompts auf dichten Modellen auch die Neural Engine, wenn das schneller ist.";
"Persistent cache" = "Dauerhafter Cache";
"--persistent-cache: keep the SSD prompt cache across restarts, so earlier conversations resume without re-prefilling." = "--persistent-cache: SSD-Prompt-Cache über Neustarts hinweg behalten, damit frühere Konversationen ohne erneutes Prefilling fortgesetzt werden.";
"splash serve — parameters" = "splash serve — Parameter";
"Changing a splash option restarts the server." = "Ändern einer splash-Option startet den Server neu.";
"UI refresh" = "UI-Aktualisierung";
"%lld ms" = "%lld ms";
"%lld s (default)" = "%lld s (Standard)";
"%lld s" = "%lld s";
"How often the app polls splash's /status endpoint to update the flyout and the menu bar. Faster is more responsive and costs a little more CPU. Changing only this does not restart the server." = "Wie oft die App den /status-Endpunkt von splash abfragt, um Flyout und Menüleiste zu aktualisieren. Schneller ist reaktiver, kostet aber etwas mehr CPU. Nur diese Änderung startet den Server nicht neu.";
"Speed graph span" = "Zeitraum des Geschwindigkeitsdiagramms";
"%lld min (default)" = "%lld min (Standard)";
"%lld min" = "%lld min";
"How many minutes of generation the tok/s graph shows. Only time spent generating is sampled, so idle gaps don't count. Changing only this does not restart the server." = "Wie viele Minuten an Generierung das tok/s-Diagramm zeigt. Nur verstrichene Generierungszeit wird abgetastet, Leerlaufphasen zählen also nicht. Nur diese Änderung startet den Server nicht neu.";
"Auto-restart" = "Auto-Neustart";
"If splash exits on its own, start it again after a moment — up to %lld times in a row before giving up. Pressing Start resets the count; a Stop always wins over it. A crash also gets a notification unless it is being auto-restarted." = "Falls splash von selbst beendet wird, nach kurzer Zeit neu starten — bis zu %lld-mal in Folge, bevor aufgegeben wird. „Starten“ drücken setzt die Zählung zurück; ein „Stoppen“ hat immer Vorrang. Auch ein Crash wird benachrichtigt, außer er wird automatisch neu gestartet.";
"Start 'splash' server on launch" = "„splash“-Server beim Start starten";
"Start the splash server with the model above whenever Splash Menu Bar launches. Off by default: the app opens with the server stopped (a splash already running on the port is still picked up), and you press Start. Changing it does not restart the server." = "Den splash-Server mit dem obigen Modell starten, wann immer Splash Menu Bar startet. Standardmäßig aus: Die App öffnet sich mit gestopptem Server (ein splash, der bereits auf dem Port läuft, wird trotzdem übernommen), und Sie drücken „Starten“. Ändern hat keinen Neustart des Servers zur Folge.";
"Launch at login" = "Beim Anmelden starten";
"Start Splash Menu Bar when you log in — with Start 'splash' server on launch also on, the splash server comes up without opening the app. Registered as a system login item (System Settings → General → Login Items); changing it does not restart the server." = "Splash Menu Bar beim Anmelden starten — zusammen mit aktiviertem „'splash'-Server beim Start starten“ kommt der splash-Server, ohne dass die App geöffnet wird. Als System-Anmeldeobjekt registriert (System Settings → Allgemein → Anmeldeobjekte); ändern hat keinen Neustart des Servers zur Folge.";
"Appearance" = "Erscheinungsbild";
"The flyout's (and this window's) color theme: follow the system's dark/light mode, or force one. The preview here updates as you pick; the flyout takes it on Save. Changing only this does not restart the server." = "Farbschema des Flyouts (und dieses Fensters): dem System-Dunkel-/Hellmodus folgen oder eines erzwingen. Die Vorschau hier aktualisiert sich beim Wählen; der Flyout übernimmt es beim Speichern. Nur diese Änderung startet den Server nicht neu.";
"Temperature" = "Temperatur";
"The unit the chip temperature shows in. System (the default) follows the computer's region — System Settings → General → Language & Region; pick Fahrenheit or Celsius to override it. Changing only this does not restart the server." = "Die Einheit, in der die Chip-Temperatur angezeigt wird. System (Standard) folgt der Region des Computers — System Settings → Allgemein → Sprache & Region; Fahrenheit oder Celsius wählen, um dies zu überschreiben. Nur diese Änderung startet den Server nicht neu.";
